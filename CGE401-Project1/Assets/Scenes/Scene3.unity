  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 1258236454}
  dialogueText: {fileID: 1515380787}
  dialogue:
  - Thank you for this!
  - My job hasn't been paying much, we're having trouble making ends meet.
  - I've got my wife and kids inside, care to meet them?
  - You're in a hurry? Well, that's alright.
  - It was nice meeting you, and thank you again!
  - (To continue to the next level, proceed to the right!)
  contButton: {fileID: 1029757492}
  wordSpeed: 0.06
  playerIsClose: 0
